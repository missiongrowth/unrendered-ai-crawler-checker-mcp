{
  "manifest_version": 3,
  "name": "Unrendered - AI Crawler Checker",
  "short_name": "Unrendered",
  "version": "0.1.2",
  "description": "Compare a page's raw HTML with its rendered HTML to see what AI crawlers that don't run JavaScript can read.",
  "minimum_chrome_version": "124",
  "permissions": [
    "activeTab",
    "scripting",
    "sidePanel",
    "declarativeNetRequestWithHostAccess"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Compare raw and rendered HTML",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
