    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/chrome": "0.3.4",
    "@types/node": "^24.0.0",
    "esbuild": "0.28.2",
    "typescript": "6.0.3"
  }
