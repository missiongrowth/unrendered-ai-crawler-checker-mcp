{
  "name": "unrendered",
  "version": "0.1.2",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "homepage": "https://missiongrowth.io/tools/unrendered",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/missiongrowth/unrendered-ai-crawler-checker-mcp.git"
  },
  "bugs": "https://github.com/missiongrowth/unrendered-ai-crawler-checker-mcp/issues",
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "e2e": "playwright test",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm build && pnpm e2e",
    "zip": "pnpm build && rm -f store/unrendered-$npm_package_version.zip && cd dist && zip -qrX ../store/unrendered-$npm_package_version.zip ."
  },
  "dependencies": {
    "google-robotstxt-parser": "1.2.0",
    "preact": "11.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.64.1",
    "@types/chrome": "0.3.7",
    "esbuild": "0.28.2",
    "eslint": "10.13.0",
    "geist": "1.8.2",
    "typescript": "7.0.2",
    "typescript-eslint": "8.72.1",
    "vitest": "5.0.5"
  }
}
